<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="550.0" prefWidth="1000.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="javaapplication6.RegisterHouseholdController">

    <stylesheets>
        <URL value="@registerhousehold.css" />
    </stylesheets>

    <children>

        <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <children>

                <VBox alignment="CENTER" spacing="12" styleClass="card">

                    <children>

                        <Label styleClass="title-label" text="Eco-Points Recycling Tracker" />

                        <Label styleClass="subtitle-label" text="Register Household">

                            <VBox.margin>
                                <Insets bottom="15" />
                            </VBox.margin>

                        </Label>

                        <Label styleClass="field-label" text="Household ID" />

                        <TextField fx:id="id" promptText="Enter household ID" styleClass="custom-textfield" />

                        <Label styleClass="field-label" text="Household Name" />

                        <TextField fx:id="name" promptText="Enter household name" styleClass="custom-textfield" />

                        <Label styleClass="field-label" text="Household Address" />

                        <TextField fx:id="address" promptText="Enter household address" styleClass="custom-textfield" />

                        <HBox alignment="CENTER" spacing="15">

    <Button onAction="#goBack" styleClass="back-button-small" text="← Go Back" />

    <Button onAction="#register" styleClass="action-button-small" text="Register Household" />

</HBox>

                    </children>

                </VBox>

            </children>

        </StackPane>

    </children>

</AnchorPane>
