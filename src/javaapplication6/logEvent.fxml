<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="javaapplication6.LogEventController">

    <stylesheets>
        <URL value="@logevent.css" />
    </stylesheets>

    <children>

        <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <children>

                <VBox alignment="CENTER" spacing="12" styleClass="card">

                    <children>

                        <Label styleClass="title-label" text="Eco-Points Recycling Tracker" />

                        <Label styleClass="subtitle-label" text="Log Recycling Event">

                            <VBox.margin>
                                <Insets bottom="15" />
                            </VBox.margin>

                        </Label>

                        <Label styleClass="field-label" text="Recycled Material" />

                        <TextField fx:id="material" promptText="Glass, Paper, Plastic or Metal" styleClass="custom-textfield" />

                        <Label styleClass="field-label" text="Quantity Recycled (KG)" />

                        <TextField fx:id="weight" promptText="Enter weight in kilograms" styleClass="custom-textfield" />

                        <Label fx:id="pointsLabel" styleClass="points-label" />

                        <HBox alignment="CENTER" spacing="15">

                            <Button onAction="#goBack" styleClass="back-button" text="← Go Back" />

                            <Button onAction="#storeEvent" styleClass="action-button" text="Log Event" />

                        </HBox>

                    </children>

                </VBox>

            </children>

        </StackPane>

    </children>

</AnchorPane>
